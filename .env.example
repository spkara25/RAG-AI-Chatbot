# Copy this file to ".env" and fill in the key for the provider you plan to use.
# You can also just paste the key directly into the sidebar in the running app,
# so committing a .env is optional.

# OpenAI (https://platform.openai.com/api-keys)
OPENAI_API_KEY=

# Google Gemini (https://aistudio.google.com/app/apikey) — has a free tier
GEMINI_API_KEY=
